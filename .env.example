# Kopirati u .env.local (Next.js i skripte ga čitaju automatski).
# Lokalno: vrednosti ispisuje `npx supabase status` (API URL, anon i service_role key).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # samo worker i admin skripte, nikad u browseru

# Javni URL aplikacije (linkovi u emailovima). Opciono lokalno.
SITE_URL=http://localhost:3000

# F2: SERP provajder
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# F1: samo za uvoz iz SE Rankinga
SERANKING_API_KEY=
